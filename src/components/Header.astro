---
import { ui, type Lang } from '../i18n/ui';
import { l, asset } from '../lib/url'; // <-- 'base' removido daqui

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = ui[lang];
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const here = Astro.url.pathname;

const segments = here.split('/');
const langIndex = segments.indexOf(lang);
if (langIndex !== -1) {
  segments[langIndex] = other;
}
const switchHref = segments.join('/');

const nav = [
  { href: l(lang), label: T.nav.home, exact: true },
  { href: l(lang, 'projects/'), label: T.nav.projects },
  { href: l(lang, 'areas/'), label: T.nav.areas },
  { href: l(lang, 'docs/'), label: T.nav.docs },
  { href: l(lang, 'about/'), label: T.nav.about },
];
const active = (n: (typeof nav)[number]) => (n.exact ? here === n.href : here.startsWith(n.href));
---
<!-- Fundo branco translúcido com borda cinza bem fininha -->
<header class="sticky top-0 z-40 border-b border-slate-200 dark:border-slate-800/50 bg-white/80 dark:bg-[#0a0f1c]/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3">
    
    <!-- Logo e Nome -->
    <a href={l(lang)} class="group flex items-center">
      <div class="relative h-10 w-10 shrink-0 overflow-hidden rounded-full border border-slate-200 dark:border-slate-700 transition-all duration-300 group-hover:border-slate-400 dark:group-hover:border-blue-500">
        <img src={asset('images/logo.png')} alt="Logo" class="h-full w-full object-cover" />
      </div>
      <div class="flex items-baseline overflow-hidden whitespace-nowrap max-w-0 opacity-0 transition-all duration-500 ease-out group-hover:ml-3 group-hover:max-w-[250px] group-hover:opacity-100">
        <span class="text-lg font-bold tracking-tight text-slate-900 dark:text-white">{T.siteName}</span>
        <span class="font-mono text-xs text-slate-500 dark:text-slate-400 ml-1.5">/ Portfolio</span>
      </div>
    </a>

    <!-- Menu de Navegação -->
    <nav aria-label="Principal" class="order-3 -mx-1 flex w-full gap-1 overflow-x-auto md:order-none md:w-auto md:items-center">
      {nav.map((n) => (
        <a
          href={n.href}
          aria-current={active(n) ? 'page' : undefined}
          class:list={[
            'relative group whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-medium transition-all duration-200',
            active(n) 
              ? 'bg-slate-100 text-slate-900 dark:bg-blue-500/10 dark:text-blue-400' 
              : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/50'
          ]}
        >
          {n.label}
          {!active(n) && (
            <span class="absolute bottom-0 left-1/2 h-[2px] w-0 -translate-x-1/2 bg-slate-400 dark:bg-blue-500 transition-all duration-300 group-hover:w-1/2"></span>
          )}
        </a>
      ))}
    </nav>

    <!-- Botões da Direita -->
    <div class="flex items-center gap-1">
      
      <!-- Botão de Idioma -->
      <a href={switchHref} class="rounded-md px-2.5 py-1.5 text-sm font-semibold text-slate-500 dark:text-slate-400 transition-all duration-200 hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800/50 dark:hover:text-white">{other.toUpperCase()}</a>
      
      <!-- Botão de Tema -->
      <button type="button" data-theme-toggle class="rounded-md p-2 text-slate-500 dark:text-slate-400 transition-all duration-200 hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800/50 dark:hover:text-white">
        <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="block dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>

      <!-- Botão de Contato -->
      <a href={l(lang, 'about/')} class="ml-2 hidden sm:inline-flex items-center justify-center rounded-md bg-slate-900 px-4 py-1.5 text-sm font-medium text-white transition-all hover:bg-slate-800 dark:bg-blue-600 dark:hover:bg-blue-500 dark:hover:shadow-[0_0_15px_rgba(37,99,235,0.4)]">
        {lang === 'pt' ? 'Contato' : 'Contact'}
      </a>

    </div>
  </div>
</header>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
  });
</script>