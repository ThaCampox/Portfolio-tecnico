---
interface Props { type?: 'info' | 'warning' | 'danger'; title?: string }
const { type = 'info', title } = Astro.props;
const tone = {
  info: 'border-accent',
  warning: 'border-[#d97706]',
  danger: 'border-[#dc2626]',
}[type];
---
<aside class={`not-prose my-6 rounded-r border-l-4 bg-surface px-4 py-3 text-sm ${tone}`}>
  {title && <p class="mb-1 font-semibold">{title}</p>}
  <div class="[&>p]:m-0 [&>p+p]:mt-2"><slot /></div>
</aside>
