---
// Raiz do site: escolhe o idioma pelo navegador (padrão: português).
import { base, asset } from '../lib/url';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <title>Thaina Campos | Technical Portfolio</title>
    <link rel="canonical" href={`${base}/pt/`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Redirecionamento (Mantido, mas com pequeno atraso para a animação aparecer) -->
    <meta http-equiv="refresh" content={`1.5; url=${base}/pt/`} />
    
    <script is:inline define:vars={{ base }}>
      // Sincroniza o tema (escuro/claro) para não dar "flash" branco na tela
      try {
        var s = localStorage.getItem('theme');
        var dark = s ? s === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      } catch (e) {}

      // Redireciona baseado no idioma
      setTimeout(function() {
        var pt = /^pt/i.test(navigator.language || 'pt');
        location.replace(base + '/' + (pt ? 'pt' : 'en') + '/');
      }, 1000); // 1 segundo de delay para o usuário ver a logo
    </script>
    
    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body class="flex min-h-screen flex-col items-center justify-center bg-bg text-ink">
    
    <!-- Container Central -->
    <div class="flex flex-col items-center animate-pulse-slow">
      
      <!-- Logo com brilho -->
      <div class="relative group mb-6">
        <div class="absolute -inset-4 rounded-full bg-gradient-to-r from-cyan-500 to-purple-600 opacity-40 blur-xl animate-pulse"></div>
        <div class="relative h-24 w-24 overflow-hidden rounded-full border-2 border-slate-700 bg-[#0a0f1c]">
          <img src={asset('images/logo.png')} alt="Logo" class="h-full w-full object-cover" />
        </div>
      </div>

      <!-- Texto de Carregamento -->
      <h1 class="text-xl font-bold tracking-tight bg-gradient-to-r from-cyan-400 to-purple-500 bg-clip-text text-transparent">
        Thaina Campos
      </h1>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 font-mono">
        Carregando portfólio<span class="animate-ping">...</span>
      </p>

      <!-- Botões manuais (Fallback) -->
      <div class="mt-12 flex items-center gap-4 text-sm font-medium z-10">
        <a href={`${base}/pt/`} class="rounded-full border border-slate-300 dark:border-slate-700 px-6 py-2 transition-all hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-blue-500">
          Acessar em Português
        </a>
        <a href={`${base}/en/`} class="rounded-full border border-slate-300 dark:border-slate-700 px-6 py-2 transition-all hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-blue-500">
          Enter in English
        </a>
      </div>

    </div>

    <style>
      /* Animação de flutuação da logo */
      @keyframes pulse-slow {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
      }
      .animate-pulse-slow {
        animation: pulse-slow 3s ease-in-out infinite;
      }
    </style>
  </body>
</html>