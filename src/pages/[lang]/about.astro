---
import Base from '../../layouts/Base.astro';
import { ui, langPaths, type Lang } from '../../i18n/ui';
import { profile, type Entry } from '../../data/profile';
import { asset } from '../../lib/url'; 

export function getStaticPaths() { return langPaths(); }
const lang = Astro.params.lang as Lang;
const T = ui[lang];
const sections: [string, Entry[]][] = [
  [T.about.experience, profile.experience],
  [T.about.education, profile.education],
];
---
<Base lang={lang} title={T.about.title} description={profile.summary[lang]}>
  <div class="mx-auto max-w-4xl px-4 py-12 md:py-20">
    
    <!-- Topo: Foto + Ícones e Apresentação -->
    <div class="flex flex-col items-center gap-10 md:flex-row md:items-center md:gap-14">
      
      <!-- Lado Esquerdo: Foto e Ícones -->
      <div class="shrink-0 flex flex-col items-center gap-5">
        
        <!-- Foto com Brilho -->
        <div class="relative group">
          <div class="absolute -inset-1 rounded-full bg-gradient-to-r from-cyan-500 to-purple-600 opacity-30 blur-lg transition duration-500 group-hover:opacity-60"></div>
          <div class="relative flex h-48 w-48 md:h-56 md:w-56 items-center justify-center rounded-full border-2 border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-[#0a0f1c] overflow-hidden">
            <img src={asset('images/logo.png')} alt="Thaina Campos" class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-110" />
          </div>
        </div>

        <!-- Ícones Sociais (Logo abaixo da foto) -->
        <div class="flex items-center gap-5">
          <!-- GitHub -->
          <a href={profile.links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-slate-500 dark:text-slate-400 transition-colors duration-300 hover:text-cyan-500 dark:hover:text-cyan-400">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="transition-transform duration-300 hover:scale-110">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-slate-500 dark:text-slate-400 transition-colors duration-300 hover:text-blue-500 dark:hover:text-blue-400">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="transition-transform duration-300 hover:scale-110">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>

          <!-- WhatsApp -->
          <a href={profile.links.whatsapp || '#'} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="text-slate-500 dark:text-slate-400 transition-colors duration-300 hover:text-green-500 dark:hover:text-green-400">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="transition-transform duration-300 hover:scale-110">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Lado Direito: Texto -->
      <div class="text-center md:text-left flex-1">
        <span class="inline-block rounded-full bg-blue-100 dark:bg-blue-500/10 px-3 py-1 text-sm font-medium text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-blue-500/20 mb-4">
          {profile.role[lang]}
        </span>
        <h1 class="text-4xl font-extrabold md:text-5xl tracking-tight bg-gradient-to-r from-cyan-500 via-blue-600 to-purple-600 dark:from-cyan-400 dark:via-blue-500 dark:to-purple-500 bg-clip-text text-transparent">
          {profile.name}
        </h1>
        <p class="mt-5 text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
          {profile.summary[lang]}
        </p>
      </div>
    </div>

    <hr class="my-12 border-slate-200 dark:border-slate-800" />

    <!-- Resto do Conteúdo (Competências, Timeline, Certificações) -->
    <div class="space-y-16">
      
      <!-- Competências -->
      <div>
        <h2 class="text-2xl font-bold tracking-tight mb-5 text-slate-900 dark:text-white">{T.about.skills}</h2>
        <ul class="flex flex-wrap gap-2 text-sm">
          {profile.skills.map((s) => (
            <li class="rounded-full border border-slate-300 bg-slate-100 px-4 py-2 font-medium text-slate-700 transition-all duration-300 hover:border-cyan-500 hover:text-cyan-600 hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-300 dark:hover:border-cyan-500 dark:hover:text-cyan-400 dark:hover:bg-slate-800 cursor-default">
              {s}
            </li>
          ))}
        </ul>
      </div>

      <!-- Experiência e Formação -->
      {sections.map(([title, entries]) => (
        <div>
          <h2 class="text-2xl font-bold tracking-tight mb-5 text-slate-900 dark:text-white">{title}</h2>
          {entries.length ? (
            <ul class="relative border-l border-slate-200 dark:border-slate-800 ml-3 space-y-8">
              {entries.map((e) => (
                <li class="ml-6">
                  <span class="absolute -left-[5px] mt-1.5 h-2.5 w-2.5 rounded-full bg-cyan-500 shadow-[0_0_10px_rgba(34,211,238,0.5)]"></span>
                  <p class="font-semibold text-lg text-slate-800 dark:text-slate-200">{e.title[lang]}</p>
                  <p class="text-sm text-slate-500 dark:text-slate-400 font-mono mt-1">{[e.place, e.period].filter(Boolean).join(' · ')}</p>
                  {e.description && <p class="mt-2 text-slate-600 dark:text-slate-400 text-sm leading-relaxed">{e.description[lang]}</p>}
                </li>
              ))}
            </ul>
          ) : (
            <div class="mt-4 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center dark:border-slate-700 dark:bg-slate-800/20">
               <p class="text-sm text-slate-500 dark:text-slate-400">Nenhuma informação cadastrada ainda.</p>
            </div>
          )}
        </div>
      ))}

      <!-- Certificações -->
      <div>
        <h2 class="text-2xl font-bold tracking-tight mb-5 text-slate-900 dark:text-white">{T.about.certifications}</h2>
        {profile.certifications.length ? (
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {profile.certifications.map((c) => (
              <li>
                {c.url ? (
                  <a href={c.url} target="_blank" rel="noopener noreferrer" class="group flex flex-col justify-between h-full rounded-xl border border-slate-200 bg-white p-4 transition-all duration-300 hover:-translate-y-1 hover:border-blue-500 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900/40 dark:hover:border-blue-500/50 dark:hover:bg-slate-800/60 dark:hover:shadow-[0_8px_30px_rgba(59,130,246,0.1)]">
                    <div>
                      <p class="font-semibold text-sm text-slate-800 dark:text-slate-200 leading-snug group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{c.title[lang]}</p>
                      <p class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400">{c.place}</p>
                    </div>
                    <div class="mt-4 flex items-center justify-between">
                      <span class="flex items-center gap-1.5 text-[10px] text-slate-400 dark:text-slate-500 font-mono">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                        {c.period}
                      </span>
                      <span class="text-blue-500 opacity-0 group-hover:opacity-100 transition-opacity">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                      </span>
                    </div>
                  </a>
                ) : (
                  <div class="flex flex-col justify-between h-full rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/40">
                    <div>
                      <p class="font-semibold text-sm text-slate-800 dark:text-slate-200 leading-snug">{c.title[lang]}</p>
                      <p class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400">{c.place}</p>
                    </div>
                    <div class="mt-4 flex items-center gap-1.5 text-[10px] text-slate-400 dark:text-slate-500 font-mono">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                      {c.period}
                    </div>
                  </div>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-slate-500 dark:text-slate-400">Nenhuma certificação cadastrada ainda.</p>
        )}
      </div>
    </div>
  </div>
</Base>