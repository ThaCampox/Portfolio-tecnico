---
import Base from '../../../layouts/Base.astro';
import DocRow from '../../../components/DocRow.astro';
import { ui, languages, type Lang } from '../../../i18n/ui';
import { areas, getArea } from '../../../data/areas';
import { getDocs } from '../../../lib/docs';
import { l } from '../../../lib/url';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).flatMap((lang) => areas.map((a) => ({ params: { lang, area: a.id } })));
}

const lang = Astro.params.lang as Lang;
const area = getArea(Astro.params.area!);
const T = ui[lang];
const docs = (await getDocs(lang)).filter((d) => d.entry.data.area === area.id);
---
<Base lang={lang} title={area.name[lang]} description={area.description[lang]}>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <a href={l(lang, 'areas/')} class="text-sm text-muted hover:text-ink">← {T.nav.areas}</a>
    <h1 class="mt-3 text-3xl font-semibold md:text-4xl">{area.name[lang]}</h1>
    <p class="mt-3 max-w-[65ch] text-muted">{area.description[lang]}</p>

    <h2 class="mt-10 text-xl font-semibold">{T.areas.docsIn}</h2>
    {docs.length
      ? <ul class="mt-4 border-t border-line">{docs.map((item) => <DocRow lang={lang} item={item} />)}</ul>
      : <p class="mt-3 text-muted">{T.areas.none}</p>}

    <h2 class="mt-10 text-xl font-semibold">{T.areas.topics}</h2>
    <ul class="mt-4 grid list-disc gap-x-10 gap-y-1 pl-5 text-muted sm:grid-cols-2">
      {area.topics[lang].map((t) => <li>{t}</li>)}
    </ul>
  </div>
</Base>
