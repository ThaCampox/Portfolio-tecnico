---
import Base from '../../layouts/Base.astro';
import { ui, langPaths, type Lang } from '../../i18n/ui';
import { getArea } from '../../data/areas';
import { backlog } from '../../data/backlog';
import { l } from '../../lib/url';

export function getStaticPaths() { return langPaths(); }
const lang = Astro.params.lang as Lang;
const T = ui[lang];
---
<Base lang={lang} title={T.projects.title} description={T.projects.lead}>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl font-semibold md:text-4xl">{T.projects.title}</h1>
    <p class="mt-3 max-w-[65ch] text-muted">{T.projects.lead}</p>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full min-w-[40rem] text-left text-sm">
        <thead class="border-b border-line text-muted">
          <tr>
            <th class="py-2 pr-4 font-medium">{T.projects.order}</th>
            <th class="py-2 pr-4 font-medium">{T.projects.project}</th>
            <th class="py-2 pr-4 font-medium">{T.projects.area}</th>
            <th class="py-2 pr-4 font-medium">{T.projects.priority}</th>
            <th class="py-2 font-medium">{T.projects.status}</th>
          </tr>
        </thead>
        <tbody>
          {backlog.map((p) => (
            <tr class="border-b border-line align-top">
              <td class="py-3 pr-4 font-mono text-muted">{String(p.order).padStart(2, '0')}</td>
              <td class="py-3 pr-4">
                {p.doc ? <a class="font-medium text-accent hover:underline" href={l(lang, `docs/${p.doc}/`)}>{p.title[lang]}</a> : <span class="font-medium">{p.title[lang]}</span>}
              </td>
              <td class="py-3 pr-4 text-muted">{getArea(p.area).name[lang]}</td>
              <td class="py-3 pr-4 text-muted">{T.labels.priority[p.priority]}</td>
              <td class="py-3"><span class="rounded border border-line px-2 py-0.5 text-xs">{T.labels.status[p.status]}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Base>
